{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client", "node"],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable",
      "DOM.AsyncIterable",
      "ESNext.Disposable"
    ],
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noUncheckedIndexedAccess": false
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "browser-tests/**/*.ts",
    "integration-tests/**/*.ts"
  ]
}
